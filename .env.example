APP_ENV=dev
# local: local review/export/import; server: administrators manage all records,
# users upload history and receive only records addressed to their accounts.
BACKEND_MODE=local
# The backend reads process environment variables; it does not load .env automatically.
# Without overrides, config.py and run_backend.bat use <project root>/.runtime/app.db.
# Optional Windows overrides (replace D:/AIassist with the actual project path):
# AIASSIST_DATA_DIR=D:/AIassist/.runtime
# DATABASE_URL=sqlite:///D:/AIassist/.runtime/app.db
# DATABASE_URL takes precedence over AIASSIST_DATA_DIR. Do not use literal %TEMP% in a URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DUPLICATE_SIMILARITY_THRESHOLD=0.62
DUPLICATE_HIGH_SIMILARITY_THRESHOLD=0.45
DUPLICATE_CANDIDATE_TOP_K=5
DUPLICATE_JUDGE_BATCH_SIZE=6
DUPLICATE_JUDGE_BATCH_CHARS=24000
DUPLICATE_CACHE_ENABLED=true
# Optional: server-local directory for versioned document module caches (30 days).
# DUPLICATE_CACHE_DIR=
EMBEDDING_DIM=384
RULE_API_BASE_URL=https://decree-tapering-that.ngrok-free.dev/rules
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=DeepSeek-V4-Flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
