[mysqld]
user=aiassist-db
datadir=/var/lib/aiassist-mysql
socket=/var/lib/aiassist-mysql/mysql.sock
pid-file=/var/lib/aiassist-mysql/mysql.pid
log-error=/var/lib/aiassist-mysql/mysql-error.log
bind-address=127.0.0.1
port=3307
mysqlx=0
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
max_allowed_packet=128M
innodb_buffer_pool_size=256M
local_infile=OFF
